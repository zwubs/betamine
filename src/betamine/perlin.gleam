fn fade(t: Float) {
  t *. t *. t *. { t *. { t *. 6.0 -. 15.0 } +. 10.0 }
}

fn lerp(t: Float, a: Float, b: Float) {
  a +. t *. { b -. a }
}

fn grad(hash: Int, x: Float, y: Float, z: Float) {
  case int.bitwise_and(hash, 0xF) {
    0x0 -> x +. y
    0x1 -> -1.0 *. x +. y
    0x2 -> x -. y
    0x3 -> -1.0 *. x -. y
    0x4 -> x +. z
    0x5 -> -1.0 *. x +. z
    0x6 -> x -. z
    0x7 -> -1.0 *. x -. z
    0x8 -> y +. z
    0x9 -> -1.0 *. y +. z
    0xA -> y -. z
    0xB -> -1.0 *. y -. z
    0xC -> y +. x
    0xD -> -1.0 *. y +. z
    0xE -> y -. x
    0xF -> -1.0 *. y -. z
    _ -> 0.0
  }
}

pub fn noise(x: Float, y: Float, z: Float) {
  let xi = float.truncate(x) |> int.clamp(0, 255)
  let yi = float.truncate(y) |> int.clamp(0, 255)
  let zi = float.truncate(z) |> int.clamp(0, 255)

  let xf = x -. float.floor(x)
  let yf = y -. float.floor(y)
  let zf = z -. float.floor(z)

  let u = fade(xf)
  let v = fade(yf)
  let w = fade(zf)

  let a = get_permutation(xi) + yi
  let aa = get_permutation(a) + zi
  let ab = get_permutation(a + 1) + zi
  let b = get_permutation(xi + 1) + yi
  let ba = get_permutation(b) + zi
  let bb = get_permutation(b + 1) + zi

  lerp(
    w,
    lerp(
      v,
      lerp(
        u,
        grad(get_permutation(aa), xf, yf, zf),
        grad(get_permutation(ba), xf -. 1.0, yf, zf),
      ),
      lerp(
        u,
        grad(get_permutation(ab), xf, yf -. 1.0, zf),
        grad(get_permutation(bb), xf -. 1.0, yf -. 1.0, zf),
      ),
    ),
    lerp(
      v,
      lerp(
        u,
        grad(get_permutation(aa + 1), xf, yf, zf -. 1.0),
        grad(get_permutation(ba + 1), xf -. 1.0, yf, zf -. 1.0),
      ),
      lerp(
        u,
        grad(get_permutation(ab + 1), xf, yf -. 1.0, zf -. 1.0),
        grad(get_permutation(bb + 1), xf -. 1.0, yf -. 1.0, zf -. 1.0),
      ),
    ),
  )
}
